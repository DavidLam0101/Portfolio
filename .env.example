# Copy to .env.local and fill in to use Supabase (real admin login, cloud storage).
# Leave empty to run in local demo mode (content is saved in your browser only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local demo mode admin login (ignored when Supabase is configured)
VITE_DEMO_ADMIN_EMAIL=admin@example.com
VITE_DEMO_ADMIN_PASSWORD=admin123
